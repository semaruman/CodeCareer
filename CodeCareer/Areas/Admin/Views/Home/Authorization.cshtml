@model AdminModel

<div class="flex min-h-[70vh] items-center justify-center py-8">
	<form asp-area="Admin" asp-controller="Home" asp-action="Authorization" class="w-full max-w-md space-y-5 rounded-3xl border border-white/20 bg-white/10 p-8 shadow-xl backdrop-blur-xl sm:p-10">
		<h3 class="text-center text-2xl font-semibold text-white">Введите пароль администратора</h3>
		<input asp-for="Password" class="w-full rounded-xl border border-white/80 bg-transparent px-4 py-3 text-white" type="password" />
		@if (ViewBag.WrongPassword != string.Empty)
		{
			<h4 class="text-center text-rose-300">@ViewBag.WrongPassword</h4>
		}
		<button type="submit" class="w-full rounded-xl bg-gradient-to-r from-purple-500 to-indigo-400 py-3 font-semibold text-white shadow-lg transition hover:brightness-110">Войти</button>
	</form>
</div>
