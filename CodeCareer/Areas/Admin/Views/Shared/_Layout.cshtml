<!DOCTYPE html>

<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <partial name="_TailwindStyles" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <title>@ViewBag.Title</title>
</head>
<body class="font-sans antialiased text-white min-h-screen overflow-x-hidden">
    <header class="sticky top-0 z-50 px-3 py-3 sm:px-4">
        <nav class="mx-auto max-w-6xl rounded-2xl border border-white/20 bg-white/10 px-3 py-2 shadow-xl backdrop-blur-xl">
            <div class="flex flex-wrap items-center justify-center gap-2">
                <span class="text-sm font-semibold text-cc-soft">Admin</span>
                <a class="rounded-xl border border-white/30 bg-white/5 px-3 py-2 text-sm" asp-area="Admin" asp-controller="Home" asp-action="Index">Главная</a>
                <a class="rounded-xl border border-white/30 bg-white/5 px-3 py-2 text-sm" asp-area="Admin" asp-controller="Home" asp-action="AddTags">Теги</a>
                <a class="rounded-xl border border-white/30 bg-white/5 px-3 py-2 text-sm" asp-area="Admin" asp-controller="Home" asp-action="AddTasks">Задачи</a>
                <a class="rounded-xl border border-white/30 bg-white/5 px-3 py-2 text-sm" asp-area="Admin" asp-controller="Home" asp-action="ManageTopics">Темы</a>
                <a class="rounded-xl border border-white/30 bg-white/5 px-3 py-2 text-sm" asp-area="Admin" asp-controller="Home" asp-action="ManageNotes">Конспекты</a>
                <a class="rounded-xl border border-white/30 bg-white/5 px-3 py-2 text-sm" asp-area="Admin" asp-controller="Home" asp-action="ManageCourses">Курсы</a>
                <a class="rounded-xl border border-white/30 bg-white/5 px-3 py-2 text-sm" asp-area="User" asp-controller="Home" asp-action="Index">Пользователь</a>
            </div>
        </nav>
    </header>
    <main class="mx-auto w-full max-w-6xl px-3 pb-10 pt-4 sm:px-4">
        @RenderBody()
    </main>
    <script src="~/js/site-nav.js"></script>
</body>
</html>
