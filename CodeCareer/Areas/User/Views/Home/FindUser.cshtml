@model FindUserViewModel

@inject ITagService TagService
@inject IUserService UserService

@{
	ViewBag.Title = "Поиск пользователя";
}

@{
	var tags = TagService.GetTagModels();

	IEnumerable<UserModel> users;

	if (Model.FindUserName == null)
	{
		Model.FindUserName = string.Empty;
	}

	if (Model.SkillTagNames == null || Model.SkillTagNames.Count() == 0)
	{
		users = UserService.GetUserModels()
		.Where(u => u.FullName.Contains(Model.FindUserName));
	}
	else
	{
		users = UserService.GetUserModels().Where(user =>
		{
			if (user.SkillTags == null || user.SkillTags.Count() == 0)
			{
				return false;
			}
			else if (!user.FullName.Contains(Model.FindUserName))
			{
				return false;
			}
			else
			{
				@*Если все выбранные теги есть у пользователя*@
				if (Model.SkillTagNames.All(tagName => user.SkillTags.Select(t => t.Name).Contains(tagName)))
				{
					return true;
				}
				return false;
			}
		});
	}
}

<div class="mx-auto mb-8 max-w-3xl text-center">
	<div class="rounded-3xl border border-white/20 bg-white/10 p-6 text-left shadow-xl backdrop-blur-xl sm:p-8">
		<form asp-area="User" asp-controller="Home" asp-action="FindUser" method="post" class="space-y-4">
			<h3 class="text-xl font-semibold text-white">Введите имя пользователя</h3>
			<input asp-for="FindUserName" value="@Model.FindUserName" class="w-full rounded-xl border border-white/80 bg-transparent px-4 py-3 text-white" />

			<h3 class="text-xl font-semibold text-white">Выберите навыки</h3>
			@foreach (var tag in tags)
			{
				if (Model.SkillTagNames.Contains(tag.Name))
				{
					<div class="flex items-center gap-2">
						<input type="checkbox"
							   name="skillTagNames"
							   value="@tag.Name"
							   checked
							   class="rounded border-white/50 bg-transparent text-purple-500" />
						<label class="text-white/90">@tag.Name</label>
					</div>
				}
				else
				{
					<div class="flex items-center gap-2">
						<input type="checkbox"
							   name="skillTagNames"
							   value="@tag.Name"
							   class="rounded border-white/50 bg-transparent text-purple-500" />
						<label class="text-white/90">@tag.Name</label>
					</div>
				}
			}
			<div class="pt-2 text-center">
				<button type="submit" class="rounded-xl bg-gradient-to-r from-purple-500 to-indigo-400 px-5 py-2.5 font-semibold text-white shadow-lg transition hover:brightness-110">Искать</button>
			</div>
		</form>
	</div>
</div>

<div class="mb-4 text-center">
	<h2 class="text-2xl font-semibold text-white">Найденные пользователи:</h2>
</div>
<div class="mx-auto max-w-3xl text-center">
	<div class="rounded-3xl border border-white/20 bg-white/10 p-6 shadow-xl backdrop-blur-xl space-y-3">
		@foreach (var user in users)
		{
			<h4><a class="text-cc-soft underline-offset-2 hover:text-white hover:underline" asp-area="User" asp-controller="Home" asp-action="AlienProfile" asp-route-userEmail="@user.Email">@user.FullName</a></h4>
		}
	</div>
</div>
