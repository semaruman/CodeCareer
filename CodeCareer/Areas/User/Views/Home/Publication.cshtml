@model PublicationDetailsViewModel
@inject ICurrentUserService CurrentUserService

@{
	ViewBag.Title = "Публикация";
	var publication = Model.Publication;
	var isLoggedIn = !string.IsNullOrEmpty(CurrentUserService.CurrentUser.Email);
}

<div class="mx-auto max-w-3xl space-y-4 px-0 sm:space-y-6">
	<nav class="text-sm text-white/60">
		<a class="hover:text-cc-soft" asp-area="User" asp-controller="Home" asp-action="PublicationFeed">Лента</a>
		<span> / </span>
		<span class="text-white">Публикация</span>
	</nav>

	<div class="rounded-3xl border border-white/20 bg-white/10 p-4 shadow-xl backdrop-blur-xl sm:p-6 md:p-8">
		<h1 class="mb-3 text-lg font-semibold text-white sm:text-xl">
			<a class="text-cc-soft underline-offset-2 hover:text-white hover:underline"
			   asp-area="User" asp-controller="Home" asp-action="AlienProfile"
			   asp-route-userEmail="@publication.User.Email">@publication.User.FullName</a>
			<span class="text-sm font-normal text-white/60 sm:text-base"> — @publication.CreatedDate.ToString("dd.MM.yyyy")</span>
		</h1>
		<p class="mb-4 whitespace-pre-wrap break-words text-white/90">@publication.Content</p>
		@if (publication.Tags != null && publication.Tags.Any())
		{
			<div class="flex flex-wrap gap-2">
				@foreach (var tag in publication.Tags)
				{
					@await Component.InvokeAsync("Tag", new { tagP = tag })
				}
			</div>
		}
	</div>

	<div class="rounded-3xl border border-white/20 bg-white/10 p-4 shadow-xl backdrop-blur-xl sm:p-6 md:p-8 space-y-4">
		<h2 class="text-lg font-semibold text-cc-soft sm:text-xl">Комментарии (@Model.Comments.Count)</h2>

		@if (Model.Comments.Any())
		{
			<div class="space-y-4">
				@foreach (var comment in Model.Comments)
				{
					<div class="rounded-2xl border border-white/15 bg-white/5 px-4 py-3">
						<div class="mb-1 flex flex-wrap items-baseline gap-2 text-sm">
							<a class="font-semibold text-cc-soft underline-offset-2 hover:text-white hover:underline"
							   asp-area="User" asp-controller="Home" asp-action="AlienProfile"
							   asp-route-userEmail="@comment.User.Email">@comment.User.FullName</a>
							<span class="text-white/50">@comment.CreatedDate.ToString("dd.MM.yyyy HH:mm")</span>
						</div>
						<p class="whitespace-pre-wrap text-white/90">@comment.Content</p>
					</div>
				}
			</div>
		}
		else
		{
			<p class="text-white/60">Пока нет комментариев. Будьте первым!</p>
		}

		@if (isLoggedIn)
		{
			<form asp-area="User" asp-controller="Home" asp-action="AddComment" method="post" class="mt-4 space-y-3 border-t border-white/15 pt-4">
				<input type="hidden" name="publicationId" value="@publication.Id" />
				<label class="block text-sm font-medium text-white" for="newCommentContent">Написать комментарий</label>
				<textarea id="newCommentContent" name="newCommentContent" rows="3"
						  class="w-full rounded-xl border border-white/80 bg-transparent px-4 py-3 text-white"
						  maxlength="1000">@Model.NewCommentContent</textarea>
				<span asp-validation-for="NewCommentContent" class="text-rose-300 text-sm"></span>
				<button type="submit"
						class="rounded-xl bg-gradient-to-r from-purple-500 to-indigo-400 px-5 py-2.5 font-semibold text-white shadow-lg transition hover:brightness-110">
					Отправить
				</button>
			</form>
		}
		else
		{
			<p class="mt-4 border-t border-white/15 pt-4 text-white/80">
				<a class="text-cc-soft hover:underline" asp-area="User" asp-controller="Home" asp-action="Authorizate">Войти</a>,
				чтобы оставить комментарий.
			</p>
		}
	</div>
</div>
