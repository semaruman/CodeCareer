@using CodeCareer.Areas.User.Services.Interfaces
@using CodeCareer.Areas.User.Services.Implementations.JsonServices

@inject IUserService UserService

@model UserModel



@{
	var subscriptions = UserService.GetUserModels().Where(u => Model.SubscriptionsEmails.Contains(u.Email));
}

<div class="mx-auto max-w-2xl">
	<h1 class="mb-6 text-3xl font-semibold text-white">Подписки <a class="text-cc-soft underline-offset-2 hover:text-white hover:underline" asp-area="User" asp-controller="Home" asp-action="AlienProfile" asp-route-userEmail="@Model.Email">@Model.FullName</a></h1>

	<div class="rounded-3xl border border-white/20 bg-white/10 p-6 shadow-xl backdrop-blur-xl space-y-3">
		@foreach (var sub in subscriptions)
		{
			<div>
				<a class="text-cc-soft underline-offset-2 hover:text-white hover:underline" asp-area="User" asp-controller="Home" asp-action="AlienProfile" asp-route-userEmail="@sub.Email">@sub.FullName</a>
			</div>
		}
	</div>
</div>
