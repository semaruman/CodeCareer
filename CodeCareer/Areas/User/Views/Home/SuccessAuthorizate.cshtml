@model UserModel
<div class="mx-auto max-w-lg text-center rounded-3xl border border-white/20 bg-white/10 p-8 shadow-xl backdrop-blur-xl">
	<h1 class="mb-6 text-3xl font-semibold text-white">Добро пожаловать, @Model.FullName</h1>

	<a class="inline-block rounded-xl bg-gradient-to-r from-purple-500 to-indigo-400 px-5 py-2.5 font-semibold text-white shadow-lg transition hover:brightness-110" asp-area="User" asp-controller="Home" asp-action="Index">Перейти на сайт!</a>
</div>
