@using CodeCareer.Areas.User.Services.Interfaces
@using CodeCareer.Areas.User.Services.Implementations.JsonServices
@model UserModel

@inject IPublicationService PublicationService

@{
	ViewBag.Title = "Профиль";
	var publications = PublicationService.GetPublicationModels().Where(p => p.User.Email == Model.Email).ToList();
	publications.Reverse();
}
<div class="mx-auto max-w-4xl">
	<div class="mb-6 rounded-3xl border border-white/20 bg-white/10 p-6 shadow-xl backdrop-blur-xl sm:p-8">
		<div>
			@*Шапка*@

		</div>
		<div class="mb-4 flex flex-wrap gap-3">
			<a class="text-cc-soft underline-offset-2 hover:text-white hover:underline" asp-area="User" asp-controller="Home" asp-action="EditProfile">Настроить профиль</a>
			<a class="text-cc-soft underline-offset-2 hover:text-white hover:underline" asp-area="User" asp-controller="Home" asp-action="AddSkillTags">Добавить навыки</a>
		</div>
		<h4 class="mb-2 text-2xl font-semibold text-white">@Model.FullName - @Model.Status</h4>
		<p class="mb-3 text-white/85">@Model.Info</p>
		<p class="mb-1"><a class="text-cc-soft underline-offset-2 hover:text-white hover:underline" asp-area="User" asp-controller="Home" asp-action="ShowSubscribes" asp-route-userEmail="@Model.Email">@Model.Subscribers подписчиков</a></p>
		<p class="mb-1"><a class="text-cc-soft underline-offset-2 hover:text-white hover:underline" asp-area="User" asp-controller="Home" asp-action="ShowSubscriptions" asp-route-userEmail="@Model.Email">@Model.Subscriptions подписок</a></p>
		<p class="mb-4 text-white/85">@Model.Rating рейтинга</p>
		<div class="flex flex-wrap gap-2">
			@foreach (var tag in Model.SkillTags)
			{
				@await Component.InvokeAsync("Tag", new { tagP = tag })
			}
		</div>
	</div>


	<div class="mb-3">
		<a class="text-cc-soft underline-offset-2 hover:text-white hover:underline" asp-area="User" asp-controller="Home" asp-action="AlienProfile" asp-route-userEmail="@Model.Email">Как мой профиль видят другие?</a>
	</div>
	<div class="mb-6">
		<a class="inline-block rounded-xl bg-gradient-to-r from-purple-500 to-indigo-400 px-5 py-2.5 font-semibold text-white shadow-lg transition hover:brightness-110" asp-area="User" asp-controller="Home" asp-action="CreatePublication">Создать публикацию</a>
	</div>
	@if (publications.Count() != 0)
	{
		<div class="flex flex-col items-center gap-4 text-center">
			<h2 class="text-2xl font-semibold text-white">Публикации</h2>
			@foreach (var publication in publications)
			{
				@await Component.InvokeAsync("Publication", new { publicationP = publication })
			}
		</div>
	}
</div>
