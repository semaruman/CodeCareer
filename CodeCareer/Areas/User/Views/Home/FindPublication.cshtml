@model FindPublicationViewModel

@inject ITagService TagService
@inject IUserService UserService
@inject IPublicationService PublicationService

@{
	ViewBag.Title = "Поиск публикации";
}

@{
	var tags = TagService.GetTagModels();

	if (Model.FindPublicationText == null)
	{
		Model.FindPublicationText = string.Empty;
	}

	List<PublicationModel> publications;
	if (Model.TagNames == null || Model.TagNames.Count() == 0)
	{
		publications = PublicationService.GetPublicationModels()
		.Where(p => p.Content.ToLower().Contains(Model.FindPublicationText.ToLower())).ToList();
	}
	else
	{
		publications = PublicationService.GetPublicationModels().Where(p =>
		{
			if (p.Tags == null || p.Tags.Count() == 0)
			{
				return false;
			}
			else if (string.IsNullOrEmpty(Model.FindPublicationText))
			{
				@*Если хотябы один тег публикации соответствует выбранным тегам пользователя*@
				if (p.Tags.Any(t => Model.TagNames.Contains(t.Name)))
				{
					return true;
				}
				return false;
			}
			else
			{
				@*Если хотябы один тег публикации соответствует выбранным тегам пользователя и содержимое соотвутствует*@
				if (p.Tags.Any(t => Model.TagNames.Contains(t.Name)) && p.Content.ToLower().Contains(Model.FindPublicationText.ToLower()))
				{
					return true;
				}
				return false;
			}
		}).ToList();
	}
}
<div class="mx-auto mb-8 max-w-3xl text-center">
	<h3 class="mb-4 text-xl font-semibold text-white">Введите часть содержимого публикации</h3>
	<div class="rounded-3xl border border-white/20 bg-white/10 p-6 text-left shadow-xl backdrop-blur-xl sm:p-8">
		<form asp-area="User" asp-controller="Home" asp-action="FindPublication" method="post" class="space-y-4">
			<label class="mb-1.5 block text-sm font-medium text-white">Вводить здесь...</label>
			<textarea asp-for="FindPublicationText" class="w-full rounded-xl border border-white/80 bg-transparent px-4 py-3 text-white" rows="4"></textarea>

			<h3 class="text-xl font-semibold text-white">Выберите теги</h3>
			@foreach (var tag in tags)
			{
				if (Model.TagNames.Contains(tag.Name))
				{
					<div class="flex items-center gap-2">
						<input type="checkbox"
							   name="tagNames"
							   value="@tag.Name"
							   checked
							   class="rounded border-white/50 bg-transparent text-purple-500" />
						<label class="text-white/90">@tag.Name</label>
					</div>
				}
				else
				{
					<div class="flex items-center gap-2">
						<input type="checkbox"
							   name="tagNames"
							   value="@tag.Name"
							   class="rounded border-white/50 bg-transparent text-purple-500" />
						<label class="text-white/90">@tag.Name</label>
					</div>
				}
			}
			<div class="pt-2 text-center">
				<button type="submit" class="rounded-xl bg-gradient-to-r from-purple-500 to-indigo-400 px-5 py-2.5 font-semibold text-white shadow-lg transition hover:brightness-110">Искать</button>
			</div>
		</form>
	</div>
</div>

<div class="mx-auto flex max-w-3xl flex-col items-center gap-4 text-center">
	<h2 class="text-2xl font-semibold text-white">Найденные публикации:</h2>
	@foreach (var publication in publications)
	{
		@await Component.InvokeAsync("Publication", new { publicationP = publication })
	}
</div>
