@model List<UserModel>

@{
	ViewBag.Title = "Топ 100 лидеров";
}

<div class="mb-6 text-center">
	<h1 class="inline-block text-3xl font-semibold text-white">Топ 100 пользователей</h1>
</div>
<div class="mx-auto max-w-3xl text-center">
	<div class="rounded-3xl border border-white/20 bg-white/10 p-6 shadow-xl backdrop-blur-xl space-y-3 sm:p-8">
		@for (int i = 0; i < Model.Count(); i++)
		{
			<h3 class="text-lg font-medium text-white"><a class="text-cc-soft underline-offset-2 hover:text-white hover:underline" asp-area="User" asp-controller="Home" asp-action="AlienProfile" asp-route-userEmail="@Model[i].Email">@Model[i].FullName</a> - @Model[i].Rating рейтинга</h3>
		}
	</div>
</div>
