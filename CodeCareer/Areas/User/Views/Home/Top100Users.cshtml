@model List<UserModel>

@{
	ViewBag.Title = "Топ 100 лидеров";
}

<div style="text-align: center;">
	<h1 class="d-inline-block">Топ 100 пользователей</h1>
</div>
<div style="text-align: center;">
	<div class="card shadow p-2 w-75 d-inline-block">
		@for (int i = 0; i < Model.Count(); i++)
		{
			<h3><a asp-area="User" asp-controller="Home" asp-action="AlienProfile" asp-route-userEmail="@Model[i].Email">@Model[i].FullName</a> - @Model[i].Rating рейтинга</h3>
		}
	</div>
</div>