@model TopicModel
@{
	ViewBag.Title = Model.Title;
	var notes = ViewBag.Notes as List<NoteModel> ?? new List<NoteModel>();
	var tasks = ViewBag.Tasks as List<TaskModel> ?? new List<TaskModel>();
	var completion = ViewBag.Completion as double? ?? 0;
}

<div class="mx-auto max-w-3xl space-y-6">
	<nav class="text-sm text-white/60">
		<a class="hover:text-cc-soft" asp-area="User" asp-controller="Learning" asp-action="Index">Обучение</a>
		<span> / </span>
		<span class="text-white">@Model.Title</span>
	</nav>

	<div class="rounded-3xl border border-white/20 bg-white/10 p-6 shadow-xl backdrop-blur-xl">
		<h1 class="text-3xl font-semibold">@Model.Title</h1>
		@if (Model.Section != null)
		{
			<p class="mt-1 text-white/70">@Model.Section.Title</p>
		}
		@if (completion > 0)
		{
			<p class="mt-3 text-sm text-cc-soft">Прогресс по теме: @completion%</p>
		}
		<div class="mt-4 flex flex-wrap gap-3">
			<a class="rounded-xl bg-gradient-to-r from-purple-500 to-indigo-400 px-4 py-2 font-semibold"
			   asp-area="User" asp-controller="Learning" asp-action="Tasks" asp-route-slug="@Model.Slug">Задачи (@tasks.Count)</a>
		</div>
	</div>

	<div class="rounded-3xl border border-white/20 bg-white/10 p-6 shadow-xl backdrop-blur-xl">
		<h2 class="mb-3 text-xl font-semibold text-cc-soft">Конспекты</h2>
		@if (notes.Any())
		{
			<ul class="space-y-2">
				@foreach (var note in notes)
				{
					<li>
						<a class="text-white hover:text-cc-soft hover:underline"
						   asp-area="User" asp-controller="Learning" asp-action="Note" asp-route-id="@note.Id">@note.Title</a>
					</li>
				}
			</ul>
		}
		else
		{
			<p class="text-white/60">Конспект пока не добавлен.</p>
		}
	</div>
</div>
